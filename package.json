{
  "name": "goodday-cloudflare",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/client/main.ts --bundle --format=iife --target=es2022 --outfile=public/app.js",
    "dev:prepare": "npm run db:migrate:local && npm run db:seed:local",
    "db:seed:local": "wrangler d1 execute goodday-tracker --local --file=./scripts/seed-local.sql",
    "dev": "npm run dev:prepare && npm run build && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply goodday-tracker --local --force",
    "dev:local": "npm run dev:prepare && npm run build && wrangler dev --local --ip 127.0.0.1 --port 8788",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.166.0"
  }
}
